<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PausaActiva"
             x:Class="PausaActiva.App">
    <Application.Resources>
        <ResourceDictionary>
            <Style TargetType="Label"><Setter Property="TextColor" Value="#EDF4F7"/><Setter Property="FontFamily" Value="OpenSansRegular"/></Style>
            <Style TargetType="ContentPage" ApplyToDerivedTypes="True"><Setter Property="BackgroundColor" Value="#101820"/></Style>
            <Style TargetType="Entry"><Setter Property="TextColor" Value="#EDF4F7"/><Setter Property="PlaceholderColor" Value="#9BAEBB"/><Setter Property="BackgroundColor" Value="#20303D"/></Style>
            <Style TargetType="Editor"><Setter Property="TextColor" Value="#EDF4F7"/><Setter Property="PlaceholderColor" Value="#9BAEBB"/><Setter Property="BackgroundColor" Value="#20303D"/></Style>
            <Style TargetType="Picker"><Setter Property="TextColor" Value="#EDF4F7"/><Setter Property="TitleColor" Value="#9BAEBB"/><Setter Property="BackgroundColor" Value="#20303D"/></Style>
            <Style TargetType="Button"><Setter Property="CornerRadius" Value="12"/><Setter Property="FontFamily" Value="OpenSansSemibold"/><Setter Property="MinimumHeightRequest" Value="48"/></Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
